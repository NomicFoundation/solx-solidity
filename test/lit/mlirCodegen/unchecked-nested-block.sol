contract C {
    function f() public pure returns (uint256 y) {
        unchecked {
            {
                uint256 max = type(uint256).max;
                uint256 x = max + 1;
                y = x;
            }
        }
    }

    function g(uint256 n) public pure returns (uint256 s) {
        unchecked {
            for (uint256 i = 0; i < n; i++) {
                s += i * 2;
            }
        }
    }
}
