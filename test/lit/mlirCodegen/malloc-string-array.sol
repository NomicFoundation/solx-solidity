contract C {
  function dyn(uint256 n) public pure returns (uint256) {
    string[] memory s = new string[](n);
    return bytes(s[0]).length;
  }

  function fixed3() public pure returns (uint256) {
    bytes[3] memory b;
    return b[1].length;
  }
}
