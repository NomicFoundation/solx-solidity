// RUN: solc --mlir-action=print-init --mmlir --mlir-print-debuginfo %s | FileCheck %s

contract C {
  struct S {
    uint256 x;
    string s;
    uint256[] a;
  }

  function newStructArray(uint256 n) public pure returns (uint256) {
    S[] memory arr = new S[](n);
    return arr[0].x;
  }

  function newNestedDyn(uint256 n) public pure returns (uint256) {
    uint256[][] memory a = new uint256[][](n);
    return a[0].length;
  }
}
