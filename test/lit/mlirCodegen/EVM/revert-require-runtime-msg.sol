contract C {
  string stored;
  function f(bool c, string memory m) public pure {
    require(c, m);
  }
  function g(string memory m) public pure {
    revert(m);
  }
  function h() public pure {
    revert("");
  }
  function i() public pure {
    revert();
  }
  // Impure message: evaluated for its side effects even when revert strings
  // are stripped.
  function impureMsg() internal returns (string memory) {
    stored = "x";
    return stored;
  }
  function j(bool c) public {
    require(c, impureMsg());
  }
  function k() public {
    revert(impureMsg());
  }
}
