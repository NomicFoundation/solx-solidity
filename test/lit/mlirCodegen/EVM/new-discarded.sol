// RUN: solc --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

contract C {
  function discarded_creation() public {
    new Child(1);
  }

  function discarded_allocation(uint256 n) public pure {
    new uint256[](n);
  }

  function discarded_reference() public pure {
    new Child;
  }
}

contract Child {
  uint256 stored;

  constructor(uint256 a) {
    stored = a;
  }
}
