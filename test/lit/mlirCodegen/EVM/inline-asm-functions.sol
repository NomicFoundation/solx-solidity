// RUN: solc --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

function ff(uint256 x) pure returns (uint256 r) {
  assembly {
    function g(a) -> b {
      b := mul(a, 5)
    }
    r := g(x)
  }
}

contract C {
  constructor() {
    assembly {
      function cf(a) -> b {
        b := add(a, 1)
      }
      sstore(0, cf(41))
    }
  }

  function f() public returns (uint256 r) {
    assembly {
      function g(x) -> y {
        y := mul(x, 2)
      }
      r := g(3)
    }
  }

  function h() public returns (uint256 r) {
    assembly {
      function g(x) -> y {
        y := mul(x, 3)
      }
      r := g(4)
    }
  }

  function k() public returns (uint256) {
    return ff(5);
  }

  function early(uint256 v) public pure returns (uint256 r) {
    assembly {
      function sel(c, a, b) -> y {
        y := b
        if c {
          y := a
          leave
        }
        y := add(y, 1)
      }
      r := sel(1, v, 7)
    }
  }
}
