contract A {
    function g() internal virtual returns (uint256) {
        return 1;
    }

    function f() public returns (uint256) {
        function() internal returns (uint256) ptr = g;
        return ptr();
    }
}

contract B is A {
    function g() internal override returns (uint256) {
        function() internal returns (uint256) up = super.g;
        return up() + 10;
    }
}
