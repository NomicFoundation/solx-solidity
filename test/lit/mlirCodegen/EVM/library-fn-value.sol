// RUN: solc --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

library L {
    function inc(uint256 a) internal pure returns (uint256) {
        return a + 1;
    }

    function dec(uint256 a) internal pure returns (uint256) {
        return a - 1;
    }

    function exec(function(uint256) internal pure returns (uint256) f, uint256 v)
        internal
        pure
        returns (uint256)
    {
        return f(v);
    }
}

contract C {
    function f(bool up, uint256 v) public pure returns (uint256) {
        return L.exec(up ? L.inc : L.dec, v);
    }
}
