// RUN: solc --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

bytes constant a = "\x03\x01\x02";
string constant c = "hello";
uint256 constant x = 56;
bytes32 constant st = "abc";

library L {
    function id(uint256 v) internal pure returns (uint256) {
        return v;
    }
}

contract C {
    function f() public pure returns (bytes memory) {
        return a;
    }

    function g() public pure returns (uint256, bytes32, uint256) {
        return (x, st, bytes(c).length);
    }

    function h() public pure returns (uint256) {
        return L.id(x);
    }
}
