// RUN: solc --mlir-action=print-std-mlir --mlir-target=evm --mmlir --mlir-print-debuginfo %s | FileCheck %s

contract C {
    uint256 public counter;

    function g() external payable {}

    function bump() internal returns (uint256) {
        counter += 1;
        return 42;
    }

    function f() public returns (bytes4, address) {
        bytes4 sel = this.g{gas: bump()}.selector;
        address a = this.g{gas: bump(), value: bump()}.address;
        return (sel, a);
    }
}
