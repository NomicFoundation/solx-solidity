// RUN: solc --mlir-action=print-init --mmlir --mlir-print-debuginfo %s | FileCheck %s

library L {
  struct S {
    uint256 v;
  }

  function bump(S storage s, uint256 amount) internal {
    s.v += amount;
  }

  function twice(uint256 x) internal pure returns (uint256) {
    return x * 2;
  }

  function total(uint256[] memory a) internal pure returns (uint256 r) {
    for (uint256 i = 0; i < a.length; i++) {
      r += a[i];
    }
  }
}

contract C {
  using L for *;
  L.S s;

  function f(uint256 n) public returns (uint256) {
    s.bump(1);
    L.bump(s, 2);
    return n.twice();
  }

  function g(uint256[] calldata a) external pure returns (uint256) {
    return a.total();
  }
}
