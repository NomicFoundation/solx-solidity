// RUN: solc --mlir-action=print-init --mmlir --mlir-print-debuginfo %s | FileCheck %s

contract C {
    uint256[] data;
    bytes bts;

    function pops() public returns (uint256 x) {
        x = 2;
        data.pop;
        bts.pop;
        x = 3;
    }

    function parens() public returns (uint256) {
        data.push(1);
        (data.pop)();
        (payable(address(this)).transfer)(0);
        return data.length;
    }

    receive() external payable {
        payable(address(this)).transfer;
        payable(address(this)).send;
    }
}
